# Personal / test artifacts — signed PDFs and exported certificates may contain
# real identity data from a CIE, so they must never be committed.
*-signed.pdf
certificato-*.pdf

# Node / SvelteKit
node_modules/
.svelte-kit/
.vite/
build/
*.tsbuildinfo
package-lock.json.bak

extra/

# Environments / secrets
.env
.env.*
!.env.example
# Local credential scratchpads — never commit
apple.txt
*-b64.txt
*.p12
*.pfx
*.cer
*.certSigningRequest
# App Store Connect API keys (private)
AuthKey_*.p8
*.p8
*.mobileprovision
*.provisionprofile

# Tauri (Rust shell)
src-tauri/target/
src-tauri/gen/schemas/

# CIE middleware binaries (provided locally, too large / licensed to commit)
external_lib/
src-tauri/resources/pkcs11/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python tooling (only if maintenance scripts use it; intentionally narrow
# patterns so they don't shadow `src/lib/` or Cargo's `target/`)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
